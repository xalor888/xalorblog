# ============ Xalor 小站 · 前端环境变量 ============

# API 前缀（必须与后端 API_PREFIX 一致）
VITE_API_PREFIX=/api

# 内容加密盐（可选）：前端会在换票/续期时对齐服务端 ENC_SALT。
# 仅在离线构建、无法走闸门时才需要与 ENC_SALT 保持一致。
# VITE_ENC_SALT=

# 开发服务器默认只监听 127.0.0.1。仅在可信局域网调试时显式开放，并限制 Host：
# VITE_DEV_HOST=0.0.0.0
# VITE_DEV_ALLOWED_HOSTS=devbox.example.test

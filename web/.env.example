# ============ Xalor 小站 · 前端环境变量 ============

# API 前缀（必须与后端 API_PREFIX 一致）
VITE_API_PREFIX=/api

# 内容加密盐（可选）：默认 xalor-content-v1；若服务端 .env 自定义了 ENC_SALT，
# 此处必须同步为相同值（否则正文解密失败）
# VITE_ENC_SALT=xalor-content-v1

# 开发服务器默认只监听 127.0.0.1。仅在可信局域网调试时显式开放，并限制 Host：
# VITE_DEV_HOST=0.0.0.0
# VITE_DEV_ALLOWED_HOSTS=devbox.example.test

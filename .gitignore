# ============ 密钥与配置（严禁入库） ============
# JWT_SECRET / DB_PASSWORD / SMTP 凭据
.env
.env.*
!**/.env.example
*.env.local
*.env.*.local

# ============ 运行时数据 ============
# 用户上传（可能含隐私图片）
server/uploads/
server/test-run.log
server/run*.out
*.log
# 变更日志仅本地保留，不上传
CHANGELOG.md
# 数据库备份（含全量数据与哈希）——注意这是**复数** backups/，与下面入库的回滚快照目录无关
deploy/backups/
# 回滚快照（deploy/backup/，**单数**）：必须入库，否则从仓库部署的机器无法回滚
# 这里显式写一条否定规则，防止将来有人加了 `deploy/` 之类的宽规则把它一起忽略掉
!deploy/backup/
!deploy/backup/**
# 本地 MySQL 数据目录
mysql/

# ============ 构建产物 ============
node_modules/
web/dist/
web/node_modules/
server/node_modules/

# ============ 测试辅助 ============
gui-test-screenshots/
coverage/
.nyc_output/
.eslintcache
.vite/

# ============ IDE / 编辑器 ============
.vscode/
.idea/
*.swp
*~
*.bak
*.orig
*.rej

# ============ 系统文件 ============
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
~$*

# ============ 本地参考仓库（不上传） ============
reference/

# ============ 本地工具缓存与临时文件（不上传） ============
.zcode/
.v2c/
.video_agent/
.workbuddy/
image.jpg
.autofix.log

# 最小生产示例。安装前替换 server_name、root 和证书/TLS 配置。
#
# ── 前置 CDN（阿里云 DCDN / 腾讯 EdgeOne 等）接入要点 ──────────────────────
# 1. 套 CDN 后 Nginx 的 TCP 对端是回源节点，必须先用 real_ip 还原访客真实 IP，
#    否则限流/IP 信誉封禁全部打在 CDN 节点上：一个垃圾提交可封掉整个边缘节点，
#    该节点后面所有访客全站 403。CDN 厂商回源网段见其官方文档（会更新，需定期同步）：
#
#     # 以厂商文档的实际网段为准，逐段列出（示例占位，勿直接照抄）：
#     # set_real_ip_from 203.0.113.0/24;
#     # set_real_ip_from 2001:db8::/32;
#     # real_ip_header X-Forwarded-For;
#     # real_ip_recursive on;
#
#    还原后 $remote_addr 即真实访客 IP，下方「覆盖式 X-Forwarded-For」无需改动，
#    后端 TRUST_PROXY=loopback 亦不变。
# 2. /api/ai/ask 为 SSE 流式响应：应用已发送 X-Accel-Buffering: no（Nginx 按响应豁免
#    缓冲）；CDN 侧必须对该路径配置动态回源不缓存，并确认厂商支持流式透传
#    （纯静态 CDN 可能整段缓冲，AI 对话会卡到最后一次性输出）。
# 3. CDN 缓存键必须保留全部查询串：/theme-init.js 与 /anti-debug.js 靠 ?v= 换版本。
# 4. 缓存规则建议：/assets/*（带内容哈希）长缓存；/uploads/* 次之；
#    /api/* 与 index.html 一律回源不缓存（rss.xml 缓存会让订阅器拉到旧文）。
# 5. 回源走 HTTPS + SNI 校验，证书用厂商免费 DV 或自有证书（CF 源站证书不可复用）。
# ─────────────────────────────────────────────────────────────────────────────
# ── 双站部署 ────────────────────────────────────────────────────────────────
# 同一个后端（127.0.0.1:3000）+ 同一份前端产物（web/dist，Vite 双入口）：
#   blog.example.com → web/dist/index.html（博客入口，hash 路由）
#   xalor.example.com → web/dist/home.html（个人主页入口，hash 路由）
# 两个域名共用 deploy/nginx-locations.inc 里的反代片段（含 /api 与 /uploads）。
# ────────────────────────────────────────────────────────────────────────────

server {
    listen 80;
    listen [::]:80;
    server_name blog.example.com;

    root /path/to/xalorblog/web/dist;
    index index.html;
    server_tokens off;

    # 与 web/index.html 的策略一致；HTTP 响应头优先且覆盖所有静态响应。
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://v1.hitokoto.cn; font-src 'self' data:; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 6m;

    include /path/to/xalorblog/deploy/nginx-locations.inc;

    # 博客入口：/ 与所有未知路径都落到 index.html
    location = /index.html {
        add_header Cache-Control "no-store";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://v1.hitokoto.cn; font-src 'self' data:; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name xalor.example.com;

    root /path/to/xalorblog/web/dist;
    # 个人主页入口是 home.html：默认文档与 SPA 兜底都要指向它
    index home.html;
    server_tokens off;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://v1.hitokoto.cn; font-src 'self' data:; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size 6m;

    include /path/to/xalorblog/deploy/nginx-locations.inc;

    location = /home.html {
        add_header Cache-Control "no-store";
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://v1.hitokoto.cn; font-src 'self' data:; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    location / {
        try_files $uri $uri/ /home.html;
    }
}

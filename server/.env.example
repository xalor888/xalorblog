# ============ Xalor 小站 · 服务端环境变量 ============

# 默认仅监听回环地址，避免访客绕过 Nginx/TLS 直连 API。
# 容器部署如需监听所有接口可显式设为 0.0.0.0，并在防火墙/安全组中只允许反代访问。
LISTEN_HOST=127.0.0.1
PORT=3000

# API 前缀（生产建议改为随机字符串，如 /gate-9f3a2b，
# 前端需通过 VITE_API_PREFIX 同步）
API_PREFIX=/api

# JWT 密钥（生产环境必须设置 32+ 位随机字符串！
# 未设置时开发模式自动生成随机密钥，服务重启后所有会话失效）
JWT_SECRET=

# 会话有效期（2h / 7d）
JWT_EXPIRES_IN=2h

# 种子脚本管理员密码：除 NODE_ENV=test 的自动化测试外必填。
# 至少 12 位，且不能是纯数字、纯字母或常见密码；不会打印到日志。
# admin123 只会在 NODE_ENV=test 时作为测试数据使用。
# SEED_ADMIN_PASSWORD=

# 数据库连接
# ⚠ DB_PASSWORD 必填；本地也请不要使用公开的默认密码
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=xalor
DB_PASSWORD=
DB_NAME=xalor_blog

# 允许的 Host 头（逗号分隔，防 Host 头注入）
# ALLOWED_HOSTS=your-domain.com,localhost
ALLOWED_HOSTS=localhost,127.0.0.1,::1

# CORS 允许的来源（逗号分隔）：默认本地开发端口；生产部署改为前端域名，
# 如 https://blog.example.com（与 ALLOWED_HOSTS 独立配置）
# CORS_ORIGINS=https://blog.example.com

# 明确信任的反向代理地址/CIDR（逗号分隔）。同机 Nginx 使用 loopback；
# 容器部署应填写反代容器所在的固定网段。禁止使用 true 或代理跳数（如 1）。
TRUST_PROXY=loopback

# 管理后台秘钥路径（可选）：默认由 JWT_SECRET 派生 12 位随机段，
# 如需自定义可设置（字母数字下划线中划线，最长 16 位），
# 前端通过 /api/anti/admin-path 自动获取，无需额外配置
# ADMIN_PATH=

# 内容加密盐：生产必须自定义（≥16 字符，禁止使用默认值 xalor-content-v1）。
# 前端会从 /anti/puzzle 运行时对齐，不必再同步 VITE_ENC_SALT；改盐会使旧密文无法解密。
# ENC_SALT=replace-with-a-long-random-string

# PoW 前导零 bit 数（开发默认 16，生产默认 20）。再高会明显拖慢首次打开。
# POW_DIFFICULTY=20
# POW_DIFFICULTY_MAX=24

# 可信 IP 白名单（逗号分隔，支持单 IP 与 CIDR，如 203.0.113.7、198.51.100.0/24）。
# 白名单 IP 不记信誉分、不会被自动封禁（站长调试 / 自家监控探活）。
# 运行后可在后台「安全中心 → WAF 防护设置」可视化维护（存 security_config 表，优先级更高）
# TRUSTED_IPS=

# 站长邮件通知（可选）：配置后新评论/留言将发送邮件提醒；
# 被回复者留过邮箱时，评论回复也会自动通知对方（邮箱仅服务端使用，不下发访客）；
# 未配置则静默跳过，不影响功能
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=blog@example.com
# SMTP_PASS=your-password
# NOTIFY_EMAIL=admin@example.com
# SMTP_SECURE=1   # 端口 465 隐式 TLS；587 默认走 STARTTLS
# SMTP_REQUIRE_TLS=1  # 默认 1，禁止明文 SMTP 会话

# AI 评论审核（本地规则引擎默认开启，零配置，评论不离开服务器）：
# 可选配置 LLM 深度二判（兼容 OpenAI Chat Completions 格式），
# 仅对本地规则判为中风险的评论调用，控制成本
# ⚠ 隐私注意：启用 LLM 后，中风险评论的文本内容会发送到 AI_BASE_URL 指向的第三方 API
#   （邮箱/昵称/IP 不会发送，仅评论正文）；请确保该服务商的隐私政策可接受
# AI_MODERATION=true
# AI_API_KEY=sk-xxxx
# AI_BASE_URL=https://api.openai.com/v1   # 仅支持 https，防明文传输/内网误配
# AI_MODEL=gpt-4o-mini
# AI_REJECT_SCORE=60   # 本地规则拒绝阈值（≥60 直接拦截）
# AI_PENDING_SCORE=30  # 本地规则待审阈值（≥30 强制人工审核）

# 生产模式
# NODE_ENV=production
#
# 通行证 jti 会落库；锁定/nonce/刮取窗/信誉仍主要在内存：只跑一个 Node 进程。
# 探活：GET /api/health/live ；就绪：GET /api/health/ready
